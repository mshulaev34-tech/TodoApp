<Window x:Class="TodoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мои Задачи" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- Ввод новой задачи -->
            <RowDefinition Height="Auto"/>
            <!-- Панель инструментов -->
            <RowDefinition Height="*"/>
            <!-- Список задач -->
        </Grid.RowDefinitions>

        <!-- 1. Заголовок -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Мои Задачи" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#333"/>
            <TextBlock Text="  (двойной клик — редактировать)" 
                       FontSize="12" 
                       Foreground="#999" 
                       VerticalAlignment="Bottom"
                       Margin="10,0,0,5"/>
        </StackPanel>

        <!-- 2. Ввод новой задачи -->
        <Border x:Name="InputBorder"
                Grid.Row="1" 
                Background="White" 
                CornerRadius="8" 
                Padding="10" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtNewTask" 
                         Grid.Column="0"
                         Padding="10" 
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Text="Что нужно сделать?"
                         Foreground="Gray"
                         GotFocus="TxtNewTask_GotFocus"
                         LostFocus="TxtNewTask_LostFocus"
                         KeyDown="TxtNewTask_KeyDown"
                         TextChanged="TxtNewTask_TextChanged"
                         MaxLength="150"/>

                <Button Content="+" 
                        Grid.Column="1"
                        Width="40" 
                        Height="40" 
                        FontSize="20"
                        FontWeight="Bold"
                        Background="#007ACC" 
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnAdd_Click"
                        Margin="5,0,0,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="20"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Сообщение об ошибке ввода -->
        <TextBlock x:Name="TxtError"
                   Grid.Row="1"
                   Text=""
                   FontSize="12"
                   Foreground="Red"
                   Margin="0,65,0,0"
                   Visibility="Collapsed"/>

        <!-- 3. Панель инструментов (Фильтры, Поиск, Сортировка) -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,0,0,10">

            <!-- Фильтры -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="RbAll" Content="Все" GroupName="FilterGroup" IsChecked="True" Checked="Filter_Changed" Margin="0,0,15,0"/>
                <RadioButton x:Name="RbActive" Content="Активные" GroupName="FilterGroup" Checked="Filter_Changed" Margin="0,0,15,0"/>
                <RadioButton x:Name="RbCompleted" Content="Выполненные" GroupName="FilterGroup" Checked="Filter_Changed"/>
            </StackPanel>

            <!-- Поиск и Сортировка -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch" 
                         Grid.Column="0"
                         Padding="8"
                         FontSize="13"
                         TextChanged="Search_Changed"
                         Background="White"
                         BorderBrush="#CCC"
                         BorderThickness="1"/>

                <ComboBox x:Name="CbSort" 
                          Grid.Column="1" 
                          Width="150" 
                          Margin="10,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="Новые сверху" Tag="DateDesc"/>
                    <ComboBoxItem Content="Старые сверху" Tag="DateAsc"/>
                    <ComboBoxItem Content="А-Я" Tag="NameAsc"/>
                    <ComboBoxItem Content="Я-А" Tag="NameDesc"/>
                </ComboBox>
            </Grid>
        </StackPanel>

        <!-- 4. Список задач с Inline Editing -->
        <ListView x:Name="LvTasks" 
                  Grid.Row="3" 
                  Background="Transparent"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  MouseDoubleClick="LvTasks_MouseDoubleClick">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <Border Background="White" 
                                        CornerRadius="8" 
                                        Margin="0,5" 
                                        Padding="10"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Margin" Value="0,2"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Чекбокс -->
                        <CheckBox Grid.Column="0"
                                  IsChecked="{Binding IsCompleted}" 
                                  Checked="ChkCompleted_Checked" 
                                  Unchecked="ChkCompleted_Unchecked"
                                  Tag="{Binding Id}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"/>

                        <TextBox x:Name="TxtTaskTitle"
                                 Grid.Column="1"
                                 Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 FontSize="16"
                                 Foreground="#333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 LostFocus="TxtTaskTitle_LostFocus"
                                 KeyDown="TxtTaskTitle_KeyDown">

                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="IsReadOnly" Value="True"/>
                                    <Setter Property="Foreground" Value="#333"/>
                                    <Style.Triggers>
                                        <!-- При выполнении зачеркиваем и делаем серым -->
                                        <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                        </DataTrigger>

                                        <!-- При редактировании включаем рамку и фон -->
                                        <DataTrigger Binding="{Binding IsReadOnly, RelativeSource={RelativeSource Self}}" Value="False">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#007ACC"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="5,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Кнопка удаления -->
                        <Button Grid.Column="2"
                                Content="✕" 
                                Foreground="#FF5252" 
                                FontWeight="Bold"
                                FontSize="14"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnDelete_Click"
                                Tag="{Binding Id}"
                                Width="30"
                                Height="30">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#FFE5E5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>